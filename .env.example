# Copy to .env and adjust. .env is git-ignored.

# mimOE's OpenAI-compatible endpoint (mimOE Studio -> Model view -> API button)
MIMOE_BASE_URL=http://localhost:8083/mimik-ai/openai/v1
MIMOE_API_KEY=1234
# Leave unset to use whichever model is loaded in mimOE Studio
# MIMOE_MODEL=qwen3-4b
# MIMOE_CGM_PATH=data/cgm_mock.csv
# MIMOE_THINKING=false

# Pydantic Logfire write token (Logfire -> project settings -> Write tokens). Unset = no export.
LOGFIRE_TOKEN=
